# Public values may be used in the browser
NUXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
NUXT_PUBLIC_SITE_URL=https://your-domain.example

# Server-only secret. Never expose this as NUXT_PUBLIC_*
NUXT_SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Cloudflare R2 is configured as a Worker binding in wrangler.jsonc.
# Do not put R2 secret keys in frontend environment variables.